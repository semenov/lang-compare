fun f(n) { var r = 0; while (n > 0) { if (n == 3) r = r + 100; n = n - 1; r = r + 1; } return r; }
print f(5);
for (var i = 0; i < 3; i = i + 1) if (i != 1) print i;
class P { init(x) { this.x = x; this.y = x * 2; } sum() { return this.x + this.y; } }
var p = P(3); print p.sum(); p.z = 9; print p.z; print p.x;
var q = P(4); q.y = 1; print q.sum();
var m = p.sum; print m();
fun g() { var o = P(1); return o.sum; } print g()();
